{
  "$schema": "https://opencode.ai/config.json",
  "username": "aki",
  "plugins": [],
  "permissions": [
    {
      "action": "read",
      "resource": "~/.config/opencode/gsd-core/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/gsd-core/*",
      "effect": "allow"
    }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "local",
        "command": [
          "bunx",
          "-y",
          "@upstash/context7-mcp",
          "--api-key",
          "{env:CONTEXT7_API_KEY}"
        ],
        "disabled": false
      },
      "chrome-devtools-headless": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--headless"],
        "disabled": true
      },
      "chrome-devtools-headed": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
        "disabled": false
      },
      "playwright": {
        "type": "local",
        "command": ["npx", "-y", "@playwright/mcp@latest"],
        "disabled": false
      },
      "gsd": {
        "type": "local",
        "command": ["npx", "-y", "-p", "@opengsd/gsd-core", "gsd-mcp-server"],
        "disabled": false
      }
    }
  },
  "lsp": {
    "typescript": {
      "command": [
        "npx",
        "--no-install",
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    }
  }
}
