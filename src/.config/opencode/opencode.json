{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "batch_tool": true
  },
  "plugin": [],
  "username": "aki",
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "@upstash/context7-mcp",
        "--api-key",
        "{env:CONTEXT7_API_KEY}"
      ],
      "enabled": true
    },
    "chrome-devtools-headless": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--headless"
      ],
      "enabled": false
    },
    "chrome-devtools-headed": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true
    },
    "gsd": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "-p",
        "@opengsd/gsd-core",
        "gsd-mcp-server"
      ],
      "enabled": true
    }
  },
  "provider": {
    "zai-coding-plan": {
      "options": {
        "apiKey": "{env:ZLM_API_KEY}"
      }
    },
    "minimax": {
      "options": {
        "apiKey": "{env:MINIMAX_API_KEY}"
      }
    }
  },
  "lsp": {
    "typescript": {
      "command": [
        "npx",
        "--no-install",
        "typescript-language-server",
        "--stdio"
      ],
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".mts",
        ".cts"
      ]
    }
  },
  "permission": {
    "read": {
      "~/.config/opencode/gsd-core/*": "allow"
    },
    "external_directory": {
      "~/.config/opencode/gsd-core/*": "allow"
    }
  }
}
